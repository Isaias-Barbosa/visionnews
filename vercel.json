{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/vercel",
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/visionnews"
    },
    {
      "source": "/admin",
      "destination": "/api/visionnews"
    },
    {
      "source": "/admin/index.html",
      "destination": "/api/visionnews"
    },
    {
      "source": "/dashboard",
      "destination": "/api/visionnews"
    },
    {
      "source": "/dashboard/index.html",
      "destination": "/api/visionnews"
    },
    {
      "source": "/rss",
      "destination": "/api/visionnews"
    },
    {
      "source": "/rss.html",
      "destination": "/api/visionnews"
    },
    {
      "source": "/noticia",
      "destination": "/noticia.html"
    },
    {
      "source": "/noticias",
      "destination": "/noticia.html"
    },
    {
      "source": "/admin/usuarios",
      "destination": "/api/visionnews"
    },
    {
      "source": "/admin/usuarios.html",
      "destination": "/api/visionnews"
    },
    {
      "source": "/admin/users",
      "destination": "/api/visionnews"
    },
    {
      "source": "/admin/users.html",
      "destination": "/api/visionnews"
    },
    {
      "source": "/admin/rss",
      "destination": "/api/visionnews"
    },
    {
      "source": "/admin/rss.html",
      "destination": "/api/visionnews"
    }
  ],
  "functions": {
    "api/visionnews.js": {
      "includeFiles": "public/{admin,dashboard}/index.html,public/rss.html,public/admin/rss.html,public/admin/usuarios.html",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
         "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data:; connect-src 'self' https://fonts.grida.co https://raw.githubusercontent.com; frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
